{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d1_bridge_manifest_core_v1.schema.json",
  "title": "D1BridgeManifestCoreV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bridge_version",
    "forecast_run_id",
    "model_version",
    "rules_version",
    "station",
    "city",
    "weather_date_local",
    "weather_metric",
    "as_of_time_utc",
    "as_of_time_cst",
    "data_status",
    "weather_bundle_content_sha256",
    "value_bundle_content_sha256",
    "source_snapshot_manifest_sha256",
    "conversion_parameters",
    "execution_eligible",
    "accepted_candidates",
    "rejected_candidates",
    "formal_ledger_used",
    "wallet_or_real_order_used"
  ],
  "properties": {
    "bridge_version": { "type": "string", "const": "d1_signal_bridge_v1" },
    "forecast_run_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "const": "D1_1500" },
    "rules_version": { "type": "string", "const": "D1_manual_v1.0" },
    "station": { "type": "string", "enum": ["ZSPD", "ZBAA"] },
    "city": { "type": "string" },
    "weather_date_local": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weather_metric": { "type": "string", "const": "highest_temperature" },
    "as_of_time_utc": { "type": "string", "format": "date-time" },
    "as_of_time_cst": { "type": "string", "format": "date-time" },
    "data_status": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL", "CONFLICTING", "STALE", "LEAKAGE_INVALID"]
    },
    "weather_bundle_content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "value_bundle_content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_snapshot_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "conversion_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_valid_minutes", "formal_mode", "orderbook_hash_verification"],
      "properties": {
        "entry_valid_minutes": { "type": "integer", "minimum": 1 },
        "formal_mode": { "type": "boolean", "const": true },
        "orderbook_hash_verification": { "type": "string", "const": "reference_format_only" }
      }
    },
    "execution_eligible": { "type": "boolean", "const": true },
    "accepted_candidates": { "type": "array", "items": { "$ref": "#/$defs/acceptedCandidate" } },
    "rejected_candidates": { "type": "array", "items": { "$ref": "#/$defs/rejectedCandidate" } },
    "formal_ledger_used": { "type": "boolean", "const": false },
    "wallet_or_real_order_used": { "type": "boolean", "const": false }
  },
  "$defs": {
    "acceptedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forecast_run_id", "model_version", "rules_version", "station", "city", "weather_date_local", "weather_metric", "temperature_bucket", "forecast_probability", "market_slug", "condition_id", "token_id", "outcome", "market_ask_price", "edge", "recommended_max_price", "intended_usd", "reason", "data_status", "orderbook_snapshot_id", "orderbook_snapshot_sha256", "orderbook_captured_at_utc", "orderbook_hash_verification"],
      "properties": {
        "forecast_run_id": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "const": "D1_1500" },
        "rules_version": { "type": "string", "const": "D1_manual_v1.0" },
        "station": { "type": "string", "enum": ["ZSPD", "ZBAA"] },
        "city": { "type": "string", "minLength": 1 },
        "weather_date_local": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "weather_metric": { "type": "string", "const": "highest_temperature" },
        "temperature_bucket": { "type": "string", "minLength": 1 },
        "forecast_probability": { "type": "string", "pattern": "^(0|1|0\\.\\d+)$" },
        "market_slug": { "type": "string", "minLength": 1 },
        "condition_id": { "type": "string", "minLength": 1 },
        "token_id": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "market_ask_price": { "type": "string", "pattern": "^(0|1|0\\.\\d+)$" },
        "edge": { "type": "string", "pattern": "^-?(0|[1-9]\\d*)(\\.\\d+)?$" },
        "recommended_max_price": { "type": "string", "pattern": "^(0|1|0\\.\\d+)$" },
        "intended_usd": { "type": "string", "pattern": "^(?:0\\.(?:0*[1-9]\\d*)|[1-9]\\d*(?:\\.\\d+)?)$" },
        "reason": { "type": "string" },
        "data_status": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "CONFLICTING", "STALE", "LEAKAGE_INVALID"] },
        "orderbook_snapshot_id": { "type": "string", "minLength": 1 },
        "orderbook_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "orderbook_captured_at_utc": { "type": "string", "format": "date-time" },
        "orderbook_hash_verification": { "type": "string", "const": "reference_format_only" }
      }
    },
    "rejectedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "code", "message", "details"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "details": { "type": "object" }
      }
    }
  }
}
