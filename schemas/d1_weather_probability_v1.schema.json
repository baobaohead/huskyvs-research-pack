{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d1_weather_probability_v1.schema.json",
  "title": "D1WeatherProbabilityBundleV1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "forecast_run_id",
    "model_version",
    "rules_version",
    "station",
    "city",
    "weather_date_local",
    "weather_metric",
    "as_of_time_utc",
    "as_of_time_cst",
    "generated_at_utc",
    "data_status",
    "confidence",
    "source_snapshot_sha256",
    "source_snapshot_manifest",
    "explanation",
    "integer_temperature_probabilities"
  ],
  "properties": {
    "forecast_run_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "rules_version": { "type": "string", "minLength": 1 },
    "station": { "type": "string", "enum": ["ZSPD", "ZBAA"] },
    "city": { "type": "string", "minLength": 1 },
    "weather_date_local": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weather_metric": { "type": "string", "minLength": 1 },
    "as_of_time_utc": { "type": "string", "minLength": 1 },
    "as_of_time_cst": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "minLength": 1 },
    "data_status": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL", "CONFLICTING", "STALE", "LEAKAGE_INVALID"]
    },
    "confidence": { "type": ["number", "string"] },
    "source_snapshot_sha256": { "type": "string", "minLength": 1 },
    "source_snapshot_manifest": { "type": "object" },
    "explanation": { "type": "string" },
    "integer_temperature_probabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["temperature_bucket", "forecast_probability"],
        "properties": {
          "temperature_bucket": { "type": "string", "minLength": 1 },
          "forecast_probability": { "type": ["number", "string"] }
        }
      }
    }
  }
}
