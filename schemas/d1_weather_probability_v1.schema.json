{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d1_weather_probability_v1.schema.json",
  "title": "D1WeatherProbabilityBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "forecast_run_id",
    "model_version",
    "rules_version",
    "station",
    "city",
    "weather_date_local",
    "weather_metric",
    "as_of_time_utc",
    "as_of_time_cst",
    "generated_at_utc",
    "data_status",
    "confidence",
    "source_snapshot_sha256",
    "source_snapshot_manifest",
    "explanation",
    "integer_temperature_probabilities"
  ],
  "properties": {
    "forecast_run_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "const": "D1_1500" },
    "rules_version": { "type": "string", "const": "D1_manual_v1.0" },
    "station": { "type": "string", "enum": ["ZSPD", "ZBAA"] },
    "city": { "type": "string", "minLength": 1 },
    "weather_date_local": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weather_metric": { "type": "string", "enum": ["highest_temperature", "high", "highest", "最高温", "最高气温"] },
    "as_of_time_utc": { "type": "string", "pattern": ".+(Z|\\+00:00)$" },
    "as_of_time_cst": { "type": "string", "pattern": ".+\\+08:00$" },
    "generated_at_utc": { "type": "string", "minLength": 1 },
    "data_status": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL", "CONFLICTING", "STALE", "LEAKAGE_INVALID"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_snapshot_manifest": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object" }
        }
      }
    },
    "explanation": { "type": "string" },
    "integer_temperature_probabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["temperature_bucket", "forecast_probability"],
        "properties": {
          "temperature_bucket": { "type": "string", "minLength": 1 },
          "forecast_probability": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
